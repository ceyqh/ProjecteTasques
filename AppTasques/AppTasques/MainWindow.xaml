 <Window x:Class="AppTasques.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppTasques"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="10, 0, 0, 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo (formulario) -->
        <Border BorderThickness="0,0,1,0" BorderBrush="Black">
            <StackPanel Margin="0, 0, 10, 0">
                <TextBlock FontSize="15" FontWeight="Bold" Margin="0, 0, 0, 10">Nova tasca:</TextBlock>

                <Border Margin="0, 0, 5, 5" Background="GhostWhite" BorderBrush="Gainsboro" BorderThickness="1">
                    <StackPanel>
                        <TextBlock>Nom:</TextBlock>
                    </StackPanel>
                </Border>

                <TextBox x:Name="txtNom" Margin="0,0,0,10"/>

                <TextBlock Margin="0,0,0,5">Descripció:</TextBlock>
                <TextBox x:Name="txtDescripcio" Height="100" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Margin="0,0,0,5">Etiqueta:</TextBlock>
                <TextBox x:Name="txtEtiqueta" Margin="0,0,0,10"/>

                <TextBlock Margin="0,0,0,5">Data inici (dd/mm/aa):</TextBlock>
                <TextBox x:Name="txtInici" Margin="0,0,0,10"/>

                <TextBlock Margin="0,0,0,5">Data final (dd/mm/aa):</TextBlock>
                <TextBox x:Name="txtFinal" Margin="0,0,0,10"/>

                <Button Width="100" Click="Afegir_Click">Afegir</Button>
            </StackPanel>
        </Border>

        <Grid  Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0">Benvingut/da {nom}</TextBlock>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right">Configuracio | canviar compte | tancar sessio | afegir usuari</TextBlock>
            </Grid>

            
            <TabControl Name="Pestanyes" TabStripPlacement="Top" Margin="0, 0, 0, 10" Grid.Row="1">
                <TabItem Header="Home">                    
                    <StackPanel>
                        
                        <ListView x:Name="llistaTasques" Grid.Row="1" MouseDoubleClick="llistaTasques_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nom" Width="120" DisplayMemberBinding="{Binding nom}"/>
                                    <GridViewColumn Header="Descripció" Width="200" DisplayMemberBinding="{Binding descripcio}"/>
                                    <GridViewColumn Header="Etiqueta" Width="100" DisplayMemberBinding="{Binding etiqueta}"/>
                                    <GridViewColumn Header="Inici" Width="80" DisplayMemberBinding="{Binding dataInici}"/>
                                    <GridViewColumn Header="Final" Width="80" DisplayMemberBinding="{Binding dataFinal}"/>
                                    <GridViewColumn Header="Estat" Width="80" DisplayMemberBinding="{Binding estat}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        
                    </StackPanel>                    
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
