<Window x:Class="AppTasques.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppTasques"
        mc:Ignorable="d"
        Title="Gestor de Tasques"
        Loaded="Window_Loaded"
        WindowState="Maximized" d:DesignHeight="450" d:DesignWidth="1800">
    
<!--HOLA-->
    <Window.Resources>
        <Style x:Key="HoverButton" TargetType="Button">
            <Setter Property="Background" Value="#FF272727"/>
            <Setter Property="Foreground" Value="#FFEFEFEA"/>
            <Setter Property="BorderBrush" Value="#FF272727"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEFEFEA"/>
                                <Setter Property="Foreground" Value="#FF272727"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFEFEFEA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="0,0,1,0" Margin="15, 10, 0, 10">
            <StackPanel Name="Expositor" Margin="0, 20, 10, 0">
                <TextBlock Name="exNomTasca" FontSize="30" Margin="0, 0, 0, 10" TextWrapping="Wrap" FontWeight="Bold" Foreground="#FF272727">Escull una tasca...</TextBlock>
                <TextBlock FontSize="15" Margin="0, 5, 0, 0" TextWrapping="Wrap">
                    <Span x:Name="exColorEtiqueta" Foreground="#FF272727">
                        <Run x:Name="exEtiqueta"/>
                    </Span>
                </TextBlock>
                <TextBlock Name="exDescripcio" FontSize="20" Margin="0, 30, 0, 0" TextWrapping="Wrap" Foreground="#FF272727"></TextBlock>
                <TextBlock FontSize="15" Margin="0, 30, 0, 0" TextWrapping="Wrap" Foreground="#FF272727">
                    <Span Background="#FF272727" Foreground="#FFEFEFEA">
                        <Run x:Name="exInici"/>
                    </Span>
                    <Span>
                        <Run x:Name="exDataInici"/>
                    </Span>
                </TextBlock>
                <TextBlock FontSize="15" Margin="0, 10, 0, 0" TextWrapping="Wrap" Foreground="#FF272727">
                    <Span Background="#FF272727" Foreground="#FFEFEFEA">
                        <Run x:Name="exFinal"/>
                    </Span>
                    <Span>
                        <Run x:Name="exDataFinal"/>
                    </Span>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid  Grid.Column="1" Margin="10, 10, 10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="15">Benvingut/da {nom}</TextBlock>
                    <Button FontSize="15" Style="{StaticResource HoverButton}" Grid.Column="1" Margin="0, 0, 10, 0" Click="FinestraUsuaris">Usuaris</Button>
                </Grid>
                
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button FontSize="15" Style="{StaticResource HoverButton}" Grid.Column="0" Margin="0, 0, 10, 0" Click="FinestraEditarTasca">Editar</Button>
                    <Button FontSize="15" Style="{StaticResource HoverButton}" Grid.Column="1" Click="FinestraNovaTasca">Nova tasca</Button>
                </Grid>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

                <ListView x:Name="llistaTasques"
                          Margin="0, 10, 0, 0"
                          Grid.Row="1"
                          MouseDoubleClick="llistaTasques_MouseDoubleClick"
                          Foreground="#FF272727"
                          BorderBrush="#FF272727"
                          Background="#FFEFEFEA">

                    <!-- ESTILS -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="#FFEFEFEA"/>
                            <Setter Property="Foreground" Value="#FF272727"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">

                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">

                                            <ContentPresenter Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF272727"/>
                                                <Setter Property="Foreground" Value="#FFEFEFEA"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF272727"/>
                                                <Setter Property="Foreground" Value="#FFEFEFEA"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <!-- *************************************************** -->

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="450"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontSize="15" Grid.Column="0" Text="{Binding nom}" Margin="0,0,30,0"/>
                                <TextBlock FontSize="15" Grid.Column="1" Text="{Binding descripcio}" Margin="0,0,30,0"/>
                                <TextBlock FontSize="15" Grid.Column="2" Margin="0,0,30,0">
                                    <Span Background="{Binding colorEtiqueta}" Foreground="#FF272727">
                                        <Run Text="{Binding etiqueta}"/>
                                    </Span>
                                </TextBlock>
                                <TextBlock FontSize="15" Grid.Column="3" Text="{Binding dataInici}" Margin="0,0,30,0"/>
                                <TextBlock FontSize="15" Grid.Column="4" Text="{Binding dataFinal}" Margin="0,0,30,0"/>
                                <TextBlock FontSize="15" Grid.Column="5" Margin="0,0,30,0">
                                    <Span Background="{Binding colorEstat}" Foreground="#FF272727">
                                        <Run Text="{Binding estat}"/>
                                    </Span>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
           
        </Grid>
    </Grid>
</Window>
