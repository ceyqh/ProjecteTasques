<Window x:Class="AppTasques.NovaTasca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppTasques"
        mc:Ignorable="d"
        Title="NovaTasca" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="0, 0, 10, 0">
            <TextBlock FontSize="15" FontWeight="Bold" Margin="0, 0, 0, 10">Nova tasca:</TextBlock>

            <Border Margin="0, 0, 5, 5" Background="GhostWhite" BorderBrush="Gainsboro" BorderThickness="1">
                <StackPanel>
                    <TextBlock>Nom:</TextBlock>
                </StackPanel>
            </Border>

            <TextBlock>Nom:</TextBlock>
            <TextBox Margin="0,0,0,10"/>

            <TextBlock Margin="0,0,0,5">Descripció:</TextBlock>
            <TextBox Height="100" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock Margin="0,0,0,5">Etiqueta:</TextBlock>
            <TextBox Margin="0,0,0,10"/>

            <TextBlock Margin="0,0,0,5">Data inici (dd/mm/aa):</TextBlock>
            <TextBox Margin="0,0,0,10"/>

            <TextBlock Margin="0,0,0,5">Data final (dd/mm/aa):</TextBlock>
            <TextBox Margin="0,0,0,10"/>

            <Button Width="100">Afegir</Button>
        </StackPanel>
    </Grid>
</Window>
