<Window x:Class="AppTasques.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppTasques"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Border Width="200" Height="250" BorderThickness="1" BorderBrush="Black">
            <StackPanel>
                <TextBlock FontSize="18" TextAlignment="Center" Margin="0, 10, 0, 20">INICIAR SESSIÓ</TextBlock>

                <TextBlock TextAlignment="Center" Margin="0, 0, 0, 5">Usuari:</TextBlock>
                <TextBox Width="150" Margin="0, 0, 0, 20"></TextBox>

                <TextBlock TextAlignment="Center" Margin="0, 0, 0, 5">Contrasenya:</TextBlock>
                <PasswordBox Width="150"></PasswordBox>

                <Button Width="70" Margin="0, 20, 0, 0" Click="Entrar">Entrar</Button>

                <TextBlock FontSize="9" TextAlignment="Center" Margin="0, 25, 0, 5" MouseLeftButtonDown="Entrar_Register">Crear usuari.</TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
