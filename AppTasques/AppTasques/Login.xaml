<Window x:Class="AppTasques.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppTasques"
        mc:Ignorable="d"
        Title="Gestor de Tasques"
        WindowState="Maximized" d:DesignHeight="450" d:DesignWidth="800">

    <Window.Resources>
        <Style x:Key="HoverButton" TargetType="Button">
            <Setter Property="Background" Value="#FF272727"/>
            <Setter Property="Foreground" Value="#FFEFEFEA"/>
            <Setter Property="BorderBrush" Value="#FF272727"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEFEFEA"/>
                                <Setter Property="Foreground" Value="#FF272727"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFEFEFEA">
        <Border Width="300" Height="300" BorderThickness="1" BorderBrush="#272727">
            <StackPanel>
                <TextBlock FontWeight="Bold"  FontSize="30" TextAlignment="Center" Margin="0, 20, 0, 20" Foreground="#FF272727">INICIAR SESSIÓ</TextBlock>

                <TextBlock FontSize="15" TextAlignment="Center" Margin="0, 0, 0, 5" Foreground="#FF272727">Usuari:</TextBlock>
                <TextBox x:Name="txtNom" FontSize="15" Width="150" Margin="0, 0, 0, 20" BorderBrush="#272727" Foreground="#FF272727" Background="#FFEFEFEA"/>

                <TextBlock FontSize="15" TextAlignment="Center" Margin="0, 0, 0, 5" Foreground="#FF272727">Contrasenya:</TextBlock>
                <PasswordBox x:Name="txtContrasenya" FontSize="15" Width="150" BorderBrush="#272727" Background="#FFEFEFEA" Foreground="#FF272727"/>


                <Button FontSize="15" Width="70" Margin="0, 40, 0, 0" Click="Entrar" Style="{StaticResource HoverButton}">Entrar</Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
